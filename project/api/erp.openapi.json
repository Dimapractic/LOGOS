{
  "openapi": "3.1.0",
  "info": {
    "title": "ERP — учебная система",
    "version": "1.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/snapshot": {
      "get": {
        "summary": "Snapshot",
        "operationId": "snapshot_snapshot_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/fault": {
      "post": {
        "summary": "Fault",
        "operationId": "fault_fault_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Fault"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "Create Order",
        "operationId": "create_order_orders_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Order"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/outbox": {
      "get": {
        "summary": "Outbox",
        "operationId": "outbox_outbox_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/commands": {
      "post": {
        "summary": "Command",
        "operationId": "command_commands_post",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Action"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "reserve",
              "ready",
              "consume",
              "book",
              "depart",
              "arrive",
              "plan",
              "complete",
              "cancel"
            ],
            "title": "Action"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "action",
          "order_id"
        ],
        "title": "Action"
      },
      "Fault": {
        "properties": {
          "delay_ms": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Delay Ms",
            "default": 0
          },
          "fail_next": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Fail Next",
            "default": 0
          },
          "lost_next": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Lost Next",
            "default": 0
          }
        },
        "type": "object",
        "title": "Fault"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Order": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "title": "Id"
          },
          "customer": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Customer"
          },
          "sku": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Sku"
          },
          "quantity": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Quantity"
          },
          "window_start": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Window Start"
          },
          "window_end": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Window End"
          },
          "picking_min": {
            "type": "integer",
            "maximum": 240.0,
            "minimum": 1.0,
            "title": "Picking Min",
            "default": 30
          },
          "loading_min": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Loading Min",
            "default": 20
          },
          "travel_min": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Travel Min",
            "default": 50
          },
          "buffer_min": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Buffer Min",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "id",
          "customer",
          "sku",
          "quantity",
          "window_start",
          "window_end"
        ],
        "title": "Order"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}