    "/api/jobs/{oid}/cancel": {
      "post": {
        "summary": "Cancel",
        "operationId": "cancel_api_jobs__oid__cancel_post",
        "parameters": [
          {
            "name": "oid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Oid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
