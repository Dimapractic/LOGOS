  },
  "components": {
    "schemas": {
      "ClockControl": {
        "properties": {
          "running": {
            "type": "boolean",
            "title": "Running"
          },
          "speed": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Speed",
            "default": 60
          }
        },
        "type": "object",
        "required": [
          "running"
        ],
        "title": "ClockControl"
      },
      "Fault": {
        "properties": {
          "delay_ms": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Delay Ms",
            "default": 0
          },
          "fail_next": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Fail Next",
            "default": 0
          },
          "lost_next": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Lost Next",
            "default": 0
          }
        },
        "type": "object",
        "title": "Fault"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Order": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "title": "Id"
          },
          "customer": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Customer"
          },
          "sku": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Sku"
          },
          "quantity": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Quantity"
          },
          "window_start": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Window Start"
          },
          "window_end": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Window End"
          },
          "picking_min": {
            "type": "integer",
            "maximum": 240.0,
            "minimum": 1.0,
            "title": "Picking Min",
            "default": 30
          },
          "loading_min": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Loading Min",
            "default": 20
          },
          "travel_min": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Travel Min",
            "default": 50
          },
          "buffer_min": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Buffer Min",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "id",
          "customer",
          "sku",
          "quantity",
          "window_start",
          "window_end"
        ],
        "title": "Order"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}